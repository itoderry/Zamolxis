# systemd unit template for Linux (user-level recommended so `claude login`
# credentials in ~/.claude are available).
#
# User service (preferred):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/zamolxis.service ~/.config/systemd/user/zamolxis.service
#   # edit WorkingDirectory + ExecStart paths below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now zamolxis
#   loginctl enable-linger "$USER"   # keep it running after logout
#
# System service: place in /etc/systemd/system/ and set User= to your account
# (NOT root/LocalSystem, or the engine won't find your Claude credentials).
#
# Enhanced security - run under a SEPARATE low-privilege account so the always-on agent
# (which can run shell commands) is sandboxed away from your own files:
#   sudo useradd -r -m -s /usr/sbin/nologin zamolxis      # dedicated service user
#   # as that user, give it its own Claude token: run `claude setup-token` and put
#   # CLAUDE_CODE_OAUTH_TOKEN=... in the Zamolxis .env; point ZAMOLXIS_DATA_DIR at a dir it owns.
#   # then set User=zamolxis below, plus the hardening lines, and install to /etc/systemd/system/.
# Optional systemd hardening for that case (uncomment in [Service]):
#   User=zamolxis
#   NoNewPrivileges=true
#   ProtectSystem=strict
#   ProtectHome=true
#   PrivateTmp=true
#   ReadWritePaths=/path/to/ZamolxisData

[Unit]
Description=Zamolxis agent daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/ABSOLUTE/PATH/TO/Zamolxis
ExecStart=/usr/bin/node --enable-source-maps dist/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
